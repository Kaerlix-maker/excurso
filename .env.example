# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # secret — server only, never NEXT_PUBLIC_

# Stripe (test mode) → Developers → API keys / Webhooks
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Public URL of the deployed site (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://excurso.vercel.app
# Optional: link used by "See a demo page" on the landing page
NEXT_PUBLIC_DEMO_PATH=/b/demo-kayak
